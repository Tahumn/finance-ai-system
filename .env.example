### Backend (FastAPI)
DB_URL=postgresql://finance_user:finance_pass@postgres:5432/finance_db

# JWT
# For local/dev you can keep this placeholder.
# For production deployments you MUST change it to a long random string.
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

### AI (Gemini) Optional
# NOTE: Do NOT commit real keys to git.
# Create your own key in Google AI Studio and paste it here.

# Recommended free-tier friendly model:
GEMINI_MODEL_NAME=gemini-flash-lite-latest

### OTP / Email Optional
# If you do not want to configure SMTP in local/dev, set DEV_RETURN_OTP=true
# and keep SMTP_* empty.
DEV_RETURN_OTP=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# SMTP_PASSWORD is a Gmail "App Password" (16 chars), not your normal Gmail password.
# Requires 2-step verification enabled. Create it at Google Account -> Security -> App passwords.
SMTP_PASSWORD=
SMTP_FROM=Finance AI <financeAI@gmail.com>
OTP_EXPIRE_MINUTES=10
