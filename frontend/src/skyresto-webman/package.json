{
    "name": "skyoffice",
    "version": "7.8.135",
    "private": true,
    "scripts": {
        "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 NEXT_PUBLIC_DCORP_VERSION=$npm_package_version env-cmd -f .env.sample next dev",
        "dev:turbo": "yarn dev --turbo",
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 NEXT_PUBLIC_DCORP_VERSION=$npm_package_version env-cmd -f .env.sample next build --experimental-debug-memory-usage",
        "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 NEXT_PUBLIC_DCORP_VERSION=$npm_package_version next start",
        "build:develop": "cross-env NODE_OPTIONS=--max-old-space-size=8192 NEXT_PUBLIC_DCORP_VERSION=$npm_package_version env-cmd -f .env.develop next build",
        "build:staging": "cross-env NODE_OPTIONS=--max-old-space-size=8192 NEXT_PUBLIC_DCORP_VERSION=$npm_package_version env-cmd -f .env.staging next build",
        "build:production": "cross-env NODE_OPTIONS=--max-old-space-size=8192 NEXT_PUBLIC_DCORP_VERSION=$npm_package_version env-cmd -f .env.production next build",
        "build:vti": "cross-env NODE_OPTIONS=--max-old-space-size=8192 NEXT_PUBLIC_DCORP_VERSION=$npm_package_version env-cmd -f .env.vti next build",
        "lint": "npx @biomejs/biome check  --write --unsafe . && yarn type:check",
        "type:check": "tsc --noEmit --pretty",
        "debug-local": "yarn run build && yarn run start",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "coverage": "env-cmd -f .env.sample vitest run --coverage",
        "test": "env-cmd -f .env.sample vitest",
        "test:ui": "env-cmd -f .env.sample vitest --ui",
        "release": "release-it"
    },
